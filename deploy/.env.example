# Copie para .env.demo (ignorado pelo Git). Gere segredos diferentes dos locais.
DB_PASSWORD=
JWT_SECRET=
# Imagens construídas fora da EC2, para linux/amd64.
BACKEND_IMAGE=finance-manager-backend:demo
FRONTEND_IMAGE=finance-manager-frontend:demo
# O frontend DEVE ser construído com NEXT_PUBLIC_API_URL=/api.
# Padrão: acesso somente pelo túnel SSH, na porta local 8088.
APP_ORIGIN=http://localhost:8088
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
HTTPS_PORT=8443
SITE_ADDRESS=:80
# Com domínio e DNS apontado para a EC2, substitua os valores acima por:
# APP_ORIGIN=https://finance.exemplo.com
# BIND_ADDRESS=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
# SITE_ADDRESS=finance.exemplo.com

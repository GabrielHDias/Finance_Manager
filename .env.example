# Execute: node scripts/init-env.mjs
# O inicializador gera os valores vazios sem substituir valores existentes.
DB_PASSWORD=
JWT_SECRET=

# Desenvolvimento local: PostgreSQL do docker-compose.yml.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/finance_manager

# Aplicação completa: compose.app.yml.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# O Compose deriva estes valores das portas acima; sobrescreva se necessário.
# NEXT_PUBLIC_API_URL=http://localhost:8080
# CORS_ALLOWED_ORIGIN=http://localhost:3000
